{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-route-advisor.local/bounded-task.schema.json",
  "title": "Codex Route Advisor Bounded Task",
  "type": "object",
  "required": [
    "id",
    "goal",
    "context",
    "dependsOn",
    "deliverable",
    "acceptance",
    "conditional",
    "boundaryReason"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^T[1-9][0-9]*$" },
    "goal": { "type": "string", "minLength": 1 },
    "context": { "type": "object" },
    "dependsOn": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^T[1-9][0-9]*$" }
    },
    "deliverable": { "type": "string", "minLength": 1 },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "conditional": {
      "oneOf": [
        { "const": false },
        {
          "type": "object",
          "required": ["taskId", "outcome"],
          "properties": {
            "taskId": { "type": "string", "pattern": "^T[1-9][0-9]*$" },
            "outcome": { "enum": ["success", "failure"] }
          },
          "additionalProperties": false
        }
      ]
    },
    "boundaryReason": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
